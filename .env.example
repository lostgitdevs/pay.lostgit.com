# ============================================
# LostGit Pay — Environment Configuration
# ============================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real credentials.

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="LostGit Pay"

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM_ADDRESS=billing@pay.lostgit.com

# --- Cron Jobs ---
CRON_SECRET=your-cron-secret-minimum-32-chars

# --- Security ---
APP_ENCRYPTION_KEY=your-encryption-key-minimum-32-chars

# --- Bootstrap ---
BOOTSTRAP_OWNER_EMAIL=owner@lostgit.com
